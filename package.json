    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "validate:content": "jest src/content",
    "test:rules": "npx --yes firebase-tools@15.34.0 emulators:exec --only auth,firestore --project demo-questforge \"jest --config jest.emulator.config.js\"",
    "verify:no-legacy": "node scripts/verify-no-legacy.js"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.emulator\\.test\\.ts$"
    ]
  }
