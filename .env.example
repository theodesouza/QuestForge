# Copie para `.env` (fora do git) e preencha com os valores do SEU projeto Firebase.
# São identificadores públicos do projeto — a segurança vem das regras do Firestore (firestore.rules)
# e da verificação do token no servidor. Para builds na nuvem, cadastre os mesmos nomes como
# variáveis de ambiente da EAS (`eas env:create`) — passo a passo em docs/CLOUD_SETUP.md.

# Firebase Console → Configurações do projeto → Seus apps → app Web (ou Android) → SDK
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Console → Authentication → Método de login → Google → "ID do cliente da Web" (termina em .apps.googleusercontent.com)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Somente na build de migração do desenvolvedor (perfil `legacy-migration` do eas.json define a flag):
# e-mail da conta Google que deve receber o progresso antigo. Se preenchido, qualquer outra conta é barrada.
# EXPO_PUBLIC_LEGACY_EXPECTED_EMAIL=
