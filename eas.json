{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "credentialsSource": "local",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_LEGACY_MIGRATION": "0"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_LEGACY_MIGRATION": "0"
      }
    },
    "legacy-migration": {
      "extends": "preview",
      "channel": "legacy-migration",
      "env": {
        "EXPO_PUBLIC_LEGACY_MIGRATION": "1"
      }
    }
  }
}
